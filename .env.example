# Database Configuration
# When running locally, it defaults to a local SQLite file (workout_mobile.db)
# When deploying to Vercel, use your free Turso Cloud SQLite database:
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional Security Passphrase for Push/Pull endpoints
# API_SECRET=your-secret-key

# Client environment variable for CLI / Antigravity
# WORKOUT_APP_URL=http://localhost:3000
